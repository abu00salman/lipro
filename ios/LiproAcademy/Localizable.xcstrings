    "contact.about": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A football academy licensed by the Ministry of Sport, training youth players aged 5 to 18 across 7 branches in Jizan, Khamis Mushait and Al-Baha."
          }
