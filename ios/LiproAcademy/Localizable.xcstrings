    "contact.about": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A football academy licensed by the Ministry of Sport, training youth players aged 5 to 18 across 7 branches in Jizan, Khamis Mushait and Al-Baha."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكاديمية كرة قدم مرخصة من وزارة الرياضة، تدرّب الناشئين من عمر ٥ إلى ١٨ سنة في ٧ فروع بمنطقة جازان وخميس مشيط والباحة."
          }
        }
      }
    },
